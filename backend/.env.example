# Copy these values into your local backend/.env for development.
# Never commit your real .env file or any real API key.
PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Create an API key in the OpenAI platform and add it here locally.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
