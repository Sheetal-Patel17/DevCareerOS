# Copy these values into your local backend/.env for development.
# Never commit your real .env file or any real API key.
PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# OAuth 2.0 Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Create a Gemini API key in Google AI Studio and add it here locally.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
