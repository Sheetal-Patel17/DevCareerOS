# Copy these values into backend/.env for local development.
# Never commit backend/.env or any real API key.
PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Gemini API key for the Career AI assistant (server-side only).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
